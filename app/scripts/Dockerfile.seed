FROM node:20-alpine
WORKDIR /app

# only necessary packages for seed scripts
RUN npm init -y > /dev/null \
 && npm install mongoose@^8.1.1 ts-node@^10.9.2 typescript@^5 @types/node@20

COPY scripts ./scripts
COPY .db ./.db

ENV MONGODB_URI=mongodb://easyshop-mongodb:27017/easyshop

CMD ["npx", "ts-node", "--transpile-only", "--project", "scripts/tsconfig.json", "scripts/migrate-data.ts"]
